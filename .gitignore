# ---- CMake build / install trees -------------------------------------------
build/
out/
install/
cmake-build-*/
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/

# ---- vcpkg -----------------------------------------------------------------
# Manifest-mode install tree (created next to vcpkg.json if configured outside
# a preset) and any exported / vendored vcpkg trees. Dependencies are restored
# from vcpkg.json + builtin-baseline, never committed.
vcpkg_installed/
vcpkg/
vcpkg-export-*/
OpenCascadeTesting/OCCT/

